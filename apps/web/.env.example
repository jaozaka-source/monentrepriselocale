# Server-side secrets for loaders, actions, and /api/* resource routes.
# Loaded by Node (`--env-file-if-exists=.env`) before the server starts, so
# read them with `process.env.NAME` inside the handler.
#
# Never give a secret a VITE_ prefix — those are inlined into the browser bundle.

# Comma-separated list of emails granted the admin role on sign-up/login.
# Example: ADMIN_EMAILS=contact@monentrepriselocale.fr,jr@jrconsulting.fr
ADMIN_EMAILS=

# Email address that receives payment / contract notifications.
NOTIFICATION_EMAIL=

# Google OAuth — set these with your real Google Cloud Console credentials.
# If the platform passes them to the PocketBase process, the oauth-config.pb.js
# hook configures the provider automatically on restart. Otherwise, configure
# them in the PocketBase admin UI (Users → Options → OAuth2 → Google).
# The redirect URI to authorize in Google Cloud Console is:
#   https://<your-domain>/hcgi/platform/api/oauth2-redirect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (test mode). Never give these a VITE_ prefix.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

CALENDLY_TOKEN=